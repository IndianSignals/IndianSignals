# --- server ---
PORT=3000
JWT_SECRET=change-me-to-a-random-string-of-32-or-more-characters
CORS_ORIGINS=https://indiansignals.github.io
DEFAULT_MODE=demo

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB=indiansignals

# --- Angel One SmartAPI (https://smartapi.angelone.in) ---
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PASSWORD=          # your 4-digit login PIN
ANGEL_TOTP_SECRET=       # base32 text shown beside the TOTP QR code (not the 6-digit code)
# Optional: skips the big instrument-master download. Verify tokens against Angel's scrip master.
# ANGEL_TOKENS=RELIANCE:2885,TCS:11536

# --- NSE calendar ---
# Official holidays from nseindia.com, yyyy-mm-dd, comma separated
NSE_HOLIDAYS=

# --- scanner ---
AUTO_SCAN_ENABLED=false
SCAN_SYMBOLS=RELIANCE,TCS,HDFCBANK,INFY,ICICIBANK,SBIN
SCAN_TIMEFRAME=15m
SCAN_INTERVAL_MS=300000
SCAN_MIN_SCORE=75

# --- trading rules (NSE cash) ---
# Stocks trade only with the NIFTY trend: strict | true | soft | false (old name BTC_FILTER still works)
INDEX_FILTER=strict
# Liquidation scoring needs a crypto liquidation feed. NSE has none, so keep it off.
LIQ_MODE=off
